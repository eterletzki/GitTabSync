<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>GitTabSync</RootNamespace>
    <AssemblyName>GitTabSync.Vsix</AssemblyName>
    <UseCodebase>true</UseCodebase>
    <UseWPF>true</UseWPF>

    <!-- Makes Microsoft.VSSDK.BuildTools import the VSIX packaging targets from the NuGet
         package (it defaults to false). This is what lets the extension build with nothing but
         the .NET SDK and MSBuild — the "Visual Studio extension development" workload is not
         required, so CI and a fresh clone can both produce a .vsix. -->
    <VSSDKBuildToolsAutoSetup>true</VSSDKBuildToolsAutoSetup>

    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <CreateVsixContainer>true</CreateVsixContainer>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <IncludeCopyLocalReferencesInVSIXContainer>true</IncludeCopyLocalReferencesInVSIXContainer>
    <DeployExtension>false</DeployExtension>

    <!-- The Visual Studio SDK reference assemblies are not nullable-annotated and the VSSDK
         targets emit their own warnings; failing the build on those would mean fighting the SDK
         rather than the code. The Core project, where the logic lives, keeps warnings as errors. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- The theme files are included twice on purpose. UseWPF compiles every .xaml in the project
         as a Page, which is what type-checks a theme at build time; the copy embedded here is the
         text, which is what ThemeLibrary writes into %LOCALAPPDATA%\GitTabSync\themes when a
         built-in theme is missing. Themes are always loaded from that folder, so the compiled
         copies are a build-time check rather than a second code path. -->
    <EmbeddedResource Include="Theming\VisualStudio.xaml" LogicalName="GitTabSync.Theming.VisualStudio.xaml" />
    <EmbeddedResource Include="Theming\Compact.xaml" LogicalName="GitTabSync.Theming.Compact.xaml" />
    <EmbeddedResource Include="Theming\Plain.xaml" LogicalName="GitTabSync.Theming.Plain.xaml" />
  </ItemGroup>

  <ItemGroup>
    <!-- 17.x reference assemblies: the APIs used here are long-standing and present in both
         Visual Studio 2022 (17.x) and 2026 (18.x), so one build targets both. -->
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="18.5.40034" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="source.extension.vsixmanifest">
      <SubType>Designer</SubType>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Compiled into the Menus.ctmenu resource that [ProvideMenuResource] registers. Without a
         command table there is no way for a user to open a tool window. -->
    <None Remove="GitTabSyncPackage.vsct" />
    <VSCTCompile Include="GitTabSyncPackage.vsct">
      <ResourceName>Menus.ctmenu</ResourceName>
    </VSCTCompile>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GitTabSync.Core\GitTabSync.Core.csproj" />
  </ItemGroup>

  <!--
    Two things read a version out of this build and they are not the same thing: Visual Studio's
    installer reads the manifest, and the What's New page reads AssemblyInformationalVersion, which
    comes from $(Version) in Directory.Build.props. If those disagree, the extension announces a
    release under a version nobody installed, and decides "have they seen this already?" against a
    number the installer never used — which is silent, and shows up as the page appearing or not
    appearing for no visible reason.

    Checked here rather than left to a release checklist because the failure is invisible in the
    built artefact: both files are individually valid, and only comparing them shows the problem.
    The companion check is ShippedReleaseTests, which asserts the changelog has an entry for this
    same version; between them, a half-finished release fails the build instead of shipping.
  -->
  <Target Name="VerifyManifestVersion" BeforeTargets="Build" Condition="'$(Version)' != ''">
    <XmlPeek XmlInputPath="source.extension.vsixmanifest"
             Query="/vsx:PackageManifest/vsx:Metadata/vsx:Identity/@Version"
             Namespaces="&lt;Namespace Prefix='vsx' Uri='http://schemas.microsoft.com/developer/vsx-schema/2011' /&gt;">
      <Output TaskParameter="Result" ItemName="VsixManifestVersion" />
    </XmlPeek>

    <Error Condition="'@(VsixManifestVersion)' == ''"
           Text="Could not read the Version from source.extension.vsixmanifest. The What's New page depends on it agreeing with $(Version)." />

    <Error Condition="'@(VsixManifestVersion)' != '$(Version)'"
           Text="Version mismatch: source.extension.vsixmanifest says @(VsixManifestVersion), but the Version property in Directory.Build.props is $(Version). These must agree — the installer uses the manifest and the What's New page uses the assembly version. Update both together (and rename CHANGELOG.md's Unreleased heading while you are there)." />
  </Target>

</Project>
