<!--
    Git Tab Sync theme: Visual Studio.

    A theme is an ordinary WPF ResourceDictionary. The settings window looks every one of these
    keys up with DynamicResource, so a key you leave out is simply not applied — the window still
    works, it just uses the control's own default for that one thing. That is what makes a theme
    safe to edit: you cannot break the window by getting a style wrong, only by writing markup that
    does not parse, and that is reported in the Git Tab Sync pane of the Output window.

    The contract, in full:

      GtsThemeName              string    the name shown in the picker
      GtsPanelMargin            Thickness around the whole panel
      GtsRowMargin              Thickness below each setting row
      GtsGroupMargin            Thickness above each section
      GtsSurfaceStyle           Border    the window's background, and the inherited text colour
      GtsTitleTextStyle         TextBlock repository and branch
      GtsHeadingTextStyle       TextBlock section headings
      GtsSettingNameTextStyle   TextBlock a setting's name (its DataContext is the setting row)
      GtsMutedTextStyle         TextBlock secondary text
      GtsNoteTextStyle          TextBlock secondary text that hides itself when empty
      GtsSeparatorStyle         Separator
      GtsComboBoxStyle          ComboBox
      GtsCheckBoxStyle          CheckBox
      GtsButtonStyle            Button    ordinary buttons
      GtsLinkButtonStyle        Button    the inline actions

    This theme takes every colour, font and control style from Visual Studio itself, so it follows
    whatever theme the IDE is in. A hardcoded colour here would look broken in dark theme, which is
    what most people are running — see Plain.xaml for a theme that uses no Visual Studio types at
    all, which is the easier one to copy if you want your own look.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0">

    <sys:String x:Key="GtsThemeName">Visual Studio</sys:String>

    <Thickness x:Key="GtsPanelMargin">12</Thickness>
    <Thickness x:Key="GtsRowMargin">0,0,0,10</Thickness>
    <Thickness x:Key="GtsGroupMargin">0,14,0,4</Thickness>

    <Style x:Key="GtsSurfaceStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
        <Setter Property="TextElement.FontFamily" Value="{DynamicResource {x:Static vsshell:VsFonts.EnvironmentFontFamilyKey}}" />
        <Setter Property="TextElement.FontSize" Value="{DynamicResource {x:Static vsshell:VsFonts.EnvironmentFontSizeKey}}" />
    </Style>

    <Style x:Key="GtsTitleTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="GtsHeadingTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="{DynamicResource GtsGroupMargin}" />
    </Style>

    <!--
        The greying of a setting whose toggle is unavailable here — not implemented yet, or set at a
        broader scope than the one selected — lives here rather than in the window, so a theme can
        say "unavailable" its own way. The window leaves the row enabled and only disables its check
        box, which keeps the explanation readable: a disabled panel greys the reason along with the
        control, and an unreadable reason is worse than none.
    -->
    <Style x:Key="GtsSettingNameTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsEditable}" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GtsMutedTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}" />
        <Setter Property="FontSize" Value="{DynamicResource {x:Static vsshell:VsFonts.Environment90PercentFontSizeKey}}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="GtsNoteTextStyle" TargetType="TextBlock" BasedOn="{StaticResource GtsMutedTextStyle}">
        <Setter Property="Margin" Value="0,1,0,0" />
        <Style.Triggers>
            <!-- Both, because an unset binding leaves null and a bound empty string leaves "". -->
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Text" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GtsSeparatorStyle" TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.PanelSeparatorKey}}" />
        <Setter Property="Margin" Value="0,14,0,0" />
    </Style>

    <Style x:Key="GtsComboBoxStyle"
           TargetType="ComboBox"
           BasedOn="{StaticResource {x:Static vsshell:VsResourceKeys.ComboBoxStyleKey}}" />

    <Style x:Key="GtsCheckBoxStyle"
           TargetType="CheckBox"
           BasedOn="{StaticResource {x:Static vsshell:VsResourceKeys.CheckBoxStyleKey}}">
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="0,2,8,0" />
    </Style>

    <Style x:Key="GtsButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource {x:Static vsshell:VsResourceKeys.ButtonStyleKey}}">
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Margin" Value="0,6,0,0" />
    </Style>

    <!--
        Written out rather than derived from a Visual Studio style because there is no shell style
        for a button that reads as a link. Inline actions in this window repeat once per row, and a
        column of push buttons reads as the loudest thing on screen when it is the least important.
    -->
    <Style x:Key="GtsLinkButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ControlLinkTextKey}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <TextBlock x:Name="Text"
                                   Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Text"
                                    Property="Foreground"
                                    Value="{DynamicResource {x:Static vsshell:VsBrushes.ControlLinkTextHoverKey}}" />
                            <Setter TargetName="Text" Property="TextDecorations" Value="Underline" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Text"
                                    Property="Foreground"
                                    Value="{DynamicResource {x:Static vsshell:VsBrushes.ControlLinkTextPressedKey}}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Text"
                                    Property="Foreground"
                                    Value="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
