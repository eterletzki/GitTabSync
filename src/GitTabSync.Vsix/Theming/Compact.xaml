<!--
    Git Tab Sync theme: Compact.

    The same look as VisualStudio.xaml, tightened for a narrow docked window. It is also the short
    example of how to build a theme on top of another one instead of copying it: the merge below
    brings in everything, and the keys redefined after it win. Source is resolved relative to this
    file, so a theme of your own can merge any other theme in this folder by file name.

    See VisualStudio.xaml for the full list of keys a theme can define.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="VisualStudio.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <sys:String x:Key="GtsThemeName">Compact</sys:String>

    <Thickness x:Key="GtsPanelMargin">8,6,8,8</Thickness>
    <Thickness x:Key="GtsRowMargin">0,0,0,5</Thickness>
    <Thickness x:Key="GtsGroupMargin">0,9,0,3</Thickness>

    <!--
        Redefining only the sizes: the foreground, the wrapping and the "not implemented yet"
        trigger all come from the merged theme, so anything that changes there changes here too.
    -->
    <Style x:Key="GtsTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource GtsTitleTextStyle}">
        <Setter Property="FontSize" Value="{DynamicResource {x:Static vsshell:VsFonts.Environment90PercentFontSizeKey}}" />
    </Style>

    <Style x:Key="GtsHeadingTextStyle" TargetType="TextBlock" BasedOn="{StaticResource GtsHeadingTextStyle}">
        <Setter Property="FontSize" Value="{DynamicResource {x:Static vsshell:VsFonts.Environment90PercentFontSizeKey}}" />
        <Setter Property="Margin" Value="{DynamicResource GtsGroupMargin}" />
    </Style>

    <Style x:Key="GtsSettingNameTextStyle" TargetType="TextBlock" BasedOn="{StaticResource GtsSettingNameTextStyle}">
        <Setter Property="FontSize" Value="{DynamicResource {x:Static vsshell:VsFonts.Environment90PercentFontSizeKey}}" />
    </Style>

    <Style x:Key="GtsMutedTextStyle" TargetType="TextBlock" BasedOn="{StaticResource GtsMutedTextStyle}">
        <Setter Property="FontSize" Value="{DynamicResource {x:Static vsshell:VsFonts.Environment66PercentFontSizeKey}}" />
    </Style>

    <Style x:Key="GtsNoteTextStyle" TargetType="TextBlock" BasedOn="{StaticResource GtsMutedTextStyle}">
        <Setter Property="Margin" Value="0,1,0,0" />
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Text" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GtsCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource GtsCheckBoxStyle}">
        <Setter Property="Margin" Value="0,1,6,0" />
    </Style>

    <Style x:Key="GtsButtonStyle" TargetType="Button" BasedOn="{StaticResource GtsButtonStyle}">
        <Setter Property="Padding" Value="8,1" />
    </Style>

    <Style x:Key="GtsSeparatorStyle" TargetType="Separator" BasedOn="{StaticResource GtsSeparatorStyle}">
        <Setter Property="Margin" Value="0,9,0,0" />
    </Style>

</ResourceDictionary>
