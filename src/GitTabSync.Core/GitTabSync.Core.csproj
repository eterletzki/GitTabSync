<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.0 so the same assembly is consumable by the .NET Framework VSIX
         and by the modern .NET test project. Deliberately no Visual Studio references:
         everything in here must be testable without the VS SDK installed. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>GitTabSync</RootNamespace>
    <AssemblyName>GitTabSync.Core</AssemblyName>
  </PropertyGroup>

  <!-- Serialization uses DataContractJsonSerializer (in-box on netstandard2.0 and .NET
       Framework), deliberately chosen over Newtonsoft/System.Text.Json: the VSIX then ships
       no extra assemblies and cannot hit binding-redirect conflicts with the copies Visual
       Studio already has loaded in-process. -->

  <ItemGroup>
    <InternalsVisibleTo Include="GitTabSync.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The changelog ships inside this assembly, and inside *this* one rather than the VSIX. That is
      the opposite of how the themes are arranged, deliberately: a theme is WPF markup that Core
      cannot interpret, so the VSIX supplies the text; a changelog's format is Core's own — the
      rules ChangelogParser applies are written at the top of the file — so there is nothing for
      the shell to supply. It is embedded rather than read from beside the extension because an
      installed VSIX is unpacked somewhere the extension has no business going looking, and a file
      that can go missing turns "what changed" into "nothing, apparently".
    -->
    <EmbeddedResource Include="..\..\CHANGELOG.md" LogicalName="GitTabSync.CHANGELOG.md" />
  </ItemGroup>

</Project>
